# =============================================================================
# BlackRoad Quantum — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Cloudflare (required for deployment)
# https://dash.cloudflare.com/profile/api-tokens
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare Access Application Audience (AUD) tag
# Used to validate Cf-Access-Jwt-Assertion headers
# https://one.dash.cloudflare.com → Access → Applications
CF_ACCESS_AUD=

# -----------------------------------------------------------------------------
# Stripe (required for payments)
# https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_

# -----------------------------------------------------------------------------
# Authentication — Cloudflare Access is the primary auth layer.
# Clerk is available as a fallback identity provider.
# https://dashboard.clerk.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_
CLERK_SECRET_KEY=sk_live_

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
# Full URL of the deployed site (used for health checks)
DEPLOY_URL=https://blackroadquantum.com

# -----------------------------------------------------------------------------
# Vendor API routing
# All AI vendor calls are routed through BlackRoad infra only.
# See docs/API_VENDORS.md for setup instructions.
# -----------------------------------------------------------------------------
BLACKROAD_API_BASE_URL=https://api.blackroad.io
BLACKROAD_API_KEY=
